server {
	listen 80;
	listen [::]:80;
	server_name _;

	root /usr/share/nginx/html;
	index index.html;

	charset utf-8;
	server_tokens off;
	absolute_redirect off;
	client_max_body_size 0;

	default_type application/octet-stream;

	types {
		text/html html htm;
		text/css css;
		application/javascript js mjs;
		application/json json map jsonc;
		application/manifest+json webmanifest;
		application/wasm wasm;
		image/svg+xml svg svgz;
		image/png png;
		image/jpeg jpg jpeg;
		image/x-icon ico;
		font/woff2 woff2;
		font/woff woff;
		font/ttf ttf;
		text/plain txt;
		text/markdown md;
	}

	gzip on;
	gzip_comp_level 5;
	gzip_min_length 1024;
	gzip_proxied any;
	gzip_vary on;
	gzip_types
		application/javascript
		application/json
		application/manifest+json
		application/wasm
		image/svg+xml
		text/css
		text/plain;

	add_header X-Content-Type-Options nosniff always;
	add_header Referrer-Policy no-referrer always;

	location = /healthz {
		access_log off;
		default_type text/plain;
		return 200 "ok\n";
	}

	location = /config.json {
		add_header Cache-Control "no-store" always;
		add_header X-Content-Type-Options nosniff always;
		try_files $uri =404;
	}

	location = /agents {
		add_header Cache-Control "no-cache" always;
		add_header X-Content-Type-Options nosniff always;
		try_files /agents.html =404;
	}

	location = /agents/ {
		return 308 /agents;
	}

	location /out/ {
		add_header Cache-Control "public, max-age=31536000, immutable" always;
		add_header X-Content-Type-Options nosniff always;
		try_files $uri =404;
	}

	location /extensions/ {
		add_header Cache-Control "public, max-age=31536000, immutable" always;
		add_header X-Content-Type-Options nosniff always;
		try_files $uri =404;
	}

	# OpenAI-compatible model endpoint for the BYOK provider extension.
	# The extension calls /llm/v1/chat/completions, which is same-origin, so the
	# browser never needs CORS on the model upstream.
	location /llm/ {
		rewrite ^/llm/(.*)$ /$1 break;
		proxy_pass ${LLM_UPSTREAM};
		proxy_http_version 1.1;
		proxy_ssl_server_name on;
		proxy_set_header Host $proxy_host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_read_timeout 600s;
		proxy_send_timeout 600s;
		proxy_buffering off;
	}

	location / {
		add_header Cache-Control "no-cache" always;
		add_header X-Content-Type-Options nosniff always;
		try_files $uri $uri/ /index.html;
	}
}
